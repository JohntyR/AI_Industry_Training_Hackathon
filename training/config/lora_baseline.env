# Nemotron LoRA fine-tuning baseline.
#
# Source: Participant_Package/handout/01_training_guide.md ("Confirmed baseline
# configuration"). These are a working starting point, not a requirement --
# record any deviation and its rationale in training/README.md.

MODEL_PATH=Llama-3.1-Nemotron-Nano-8B-v1

MAX_STEPS=100
BATCH_SIZE=2
GRAD_ACCUM=4          # effective batch = 8
LORA_RANK=32

# Do NOT raise to 1e-4 -- it causes a loss spike at warmup step 50.
LR=5e-5

# Longer sequences OOM on a single GB10 node. Drop to 256 if still OOMing.
MAX_SEQ_LEN=512

WARMUP_STEPS=50
CHECKPOINT_EVERY=20

# Must be 25.09 or newer -- 25.04 crashes on GB10.
NEMO_IMAGE=nvcr.io/nvidia/nemo:25.09
